    tab: (active) => ({ padding:"8px 18px", borderRadius:8, border:"none", background: active?"rgba(120,80,255,0.25)":"transparent", color: active?"#c4b5fd":"rgba(200,180,255,0.5)", fontSize:13, fontWeight: active?600:400, cursor:"pointer", fontFamily:"inherit", transition:"all 0.15s" }),
  };

  return (
    <div style={S.app}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap');
        @keyframes spin { to { transform: rotate(360deg); } }
