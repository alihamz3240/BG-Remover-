        input:focus { border-color: rgba(167,139,250,0.5) !important; outline: none; }
        ::-webkit-scrollbar { width:6px; } ::-webkit-scrollbar-track { background:#080810; } ::-webkit-scrollbar-thumb { background:#3b2a7a; border-radius:3px; }
      `}</style>
      <div style={S.glow1} /><div style={S.glow2} />

