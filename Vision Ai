                {loading && (
                  <div style={{ ...S.imgGrid, marginBottom:16 }}>
                    {Array.from({ length: numImages }).map((_,i) => <LoadingCard key={i} ratio={ratio} />)}
                  </div>
                )}
                {images.length === 0 && !loading ? (
                  <div style={{ ...S.card, textAlign:"center", padding:"80px 40px" }}>
                    <div style={{ fontSize:48, marginBottom:16 }}>✦</div>
                    <p style={{ color:"rgba(160,140,255,0.5)", fontSize:15, margin:0 }}>Your generated images will appear here</p>
                    <p style={{ color:"rgba(160,140,255,0.3)", fontSize:13, marginTop:8 }}>Enter a prompt and click Generate to start creating</p>
                  </div>
                ) : (
                  <div style={S.imgGrid}>
                    {images.map(img => <ImageCard key={img.id} item={img} onReuse={p => { setPrompt(p); toast("Prompt loaded!"); }} />)}
                  </div>
                )}
              </>
            )}

            {tab === "history" && (
              <>
                {history.length === 0 ? (
                  <div style={{ ...S.card, textAlign:"center", padding:"60px 40px" }}>
                    <p style={{ color:"rgba(160,140,255,0.5)", fontSize:15, margin:0 }}>No history yet</p>
                  </div>
                ) : (
                  <div style={S.imgGrid}>
                    {history.map(img => <ImageCard key={img.id} item={img} onReuse={p => { setPrompt(p); setTab("generate"); toast("Prompt loaded!"); }} />)}
                  </div>
                )}
              </>
            )}
          </div>
        </div>

        {/* Features Section */}
        <div style={{ marginTop:80, textAlign:"center" }}>
          <div style={{ fontSize:11, letterSpacing:"0.12em", color:"rgba(167,139,250,0.6)", textTransform:"uppercase", marginBottom:16 }}>Capabilities</div>
          <h2 style={{ fontSize:"clamp(28px,4vw,42px)", fontWeight:800, letterSpacing:"-1px", margin:"0 0 48px", background:"linear-gradient(135deg,#fff,#a78bfa)", WebkitBackgroundClip:"text", WebkitTextFillColor:"transparent" }}>Everything you need to create</h2>
          <div style={{ display:"grid", gridTemplateColumns:"repeat(3, 1fr)", gap:16 }}>
            {[
              { icon:"⚡", title:"Ultra-Fast Generation", desc:"DALL-E 3 delivers stunning images in seconds with unprecedented detail and accuracy" },
              { icon:"🎨", title:"10 Style Presets", desc:"From photorealistic to anime, cyberpunk to watercolor — find your perfect aesthetic" },
              { icon:"✨", title:"AI Prompt Enhancer", desc:"Claude AI supercharges your prompts to unlock more vivid, detailed, and creative results" },
              { icon:"📐", title:"Flexible Aspect Ratios", desc:"Create portraits, landscapes, or squares — optimized for any platform or use case" },
              { icon:"💎", title:"HD Quality Mode", desc:"Generate high-definition images with exceptional clarity for professional use" },
              { icon:"🔄", title:"Unlimited History", desc:"All your generations saved locally. Revisit, reuse, and iterate on any previous creation" },
            ].map((f,i) => (
              <div key={i} style={{ ...S.card, textAlign:"left" }}>
                <div style={{ fontSize:28, marginBottom:12 }}>{f.icon}</div>
                <h3 style={{ fontSize:15, fontWeight:700, margin:"0 0 8px", color:"#e8e4ff" }}>{f.title}</h3>
                <p style={{ fontSize:13, color:"rgba(160,140,255,0.6)", margin:0, lineHeight:1.6 }}>{f.desc}</p>
              </div>
            ))}
          </div>
        </div>

        {/* Pricing */}
        <div style={{ marginTop:80, textAlign:"center" }}>
          <div style={{ fontSize:11, letterSpacing:"0.12em", color:"rgba(167,139,250,0.6)", textTransform:"uppercase", marginBottom:16 }}>Pricing</div>
          <h2 style={{ fontSize:"clamp(28px,4vw,42px)", fontWeight:800, letterSpacing:"-1px", margin:"0 0 48px", background:"linear-gradient(135deg,#fff,#a78bfa)", WebkitBackgroundClip:"text", WebkitTextFillColor:"transparent" }}>Simple, transparent pricing</h2>
          <div style={{ display:"grid", gridTemplateColumns:"repeat(3,1fr)", gap:16, maxWidth:860, margin:"0 auto" }}>
            {[
              { name:"Starter", price:"$9", period:"/mo", credits:"50 credits", features:["50 image generations","Standard quality","5 style presets","Community support"], highlight:false },
              { name:"Creator", price:"$29", period:"/mo", credits:"250 credits", features:["250 image generations","HD quality mode","All 10 style presets","Prompt enhancer","Priority generation","Email support"], highlight:true },
              { name:"Studio", price:"$79", period:"/mo", credits:"Unlimited", features:["Unlimited generations","HD + Ultra quality","Custom style presets","API access","Team workspace","Dedicated support"], highlight:false },
            ].map((p,i) => (
              <div key={i} style={{ ...S.card, position:"relative", border: p.highlight?"1px solid rgba(167,139,250,0.5)":"1px solid rgba(120,80,255,0.2)", background: p.highlight?"rgba(120,80,255,0.12)":"rgba(15,15,28,0.9)" }}>
                {p.highlight && <div style={{ position:"absolute", top:-12, left:"50%", transform:"translateX(-50%)", background:"linear-gradient(135deg,#7c3aed,#4f46e5)", color:"#fff", fontSize:11, fontWeight:700, padding:"4px 14px", borderRadius:100, letterSpacing:"0.06em" }}>MOST POPULAR</div>}
                <div style={{ marginBottom:20 }}>
                  <p style={{ fontSize:12, color:"rgba(167,139,250,0.6)", margin:"0 0 4px", textTransform:"uppercase", letterSpacing:"0.08em" }}>{p.name}</p>
                  <div style={{ display:"flex", alignItems:"baseline", gap:4 }}>
                    <span style={{ fontSize:42, fontWeight:800, color:"#e8e4ff" }}>{p.price}</span>
                    <span style={{ fontSize:14, color:"rgba(160,140,255,0.5)" }}>{p.period}</span>
                  </div>
                  <p style={{ fontSize:12, color:"rgba(167,139,250,0.5)", margin:"4px 0 0", fontFamily:"'DM Mono', monospace" }}>{p.credits}</p>
                </div>
                <div style={{ display:"flex", flexDirection:"column", gap:8, marginBottom:20 }}>
                  {p.features.map((f,j) => <div key={j} style={{ display:"flex", alignItems:"center", gap:8, fontSize:13, color:"rgba(200,185,255,0.8)" }}><span style={{ color:"#a78bfa", fontSize:12 }}>✓</span>{f}</div>)}
                </div>
                <button style={{ width:"100%", padding:"11px 0", borderRadius:10, border: p.highlight?"none":"1px solid rgba(120,80,255,0.3)", background: p.highlight?"linear-gradient(135deg,#7c3aed,#4f46e5)":"rgba(120,80,255,0.1)", color:"#e8e4ff", fontSize:14, fontWeight:600, cursor:"pointer", fontFamily:"inherit" }}>Get Started</button>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* API Key Modal */}
      {showApiModal && (
        <div style={{ position:"fixed", inset:0, background:"rgba(0,0,0,0.85)", zIndex:1000, display:"flex", alignItems:"center", justifyContent:"center", padding:24 }}
          onClick={e => { if(e.target===e.currentTarget) setShowApiModal(false); }}>
          <div style={{ background:"#0f0f1e", border:"1px solid rgba(120,80,255,0.35)", borderRadius:20, padding:32, maxWidth:440, width:"100%" }}>
            <div style={{ fontSize:28, marginBottom:8 }}>⚡</div>
            <h2 style={{ fontSize:20, fontWeight:800, margin:"0 0 8px", color:"#e8e4ff" }}>Connect OpenAI API</h2>
            <p style={{ fontSize:13, color:"rgba(160,140,255,0.6)", margin:"0 0 24px", lineHeight:1.6 }}>Enter your OpenAI API key to start generating images. Your key is stored locally and never sent to our servers.</p>
            <input
              type="password"
              value={apiKeyInput}
              onChange={e => setApiKeyInput(e.target.value)}
              placeholder="sk-..."
              style={{ width:"100%", background:"rgba(120,80,255,0.08)", border:"1px solid rgba(120,80,255,0.25)", borderRadius:10, color:"#e8e4ff", fontSize:14, padding:"12px 14px", fontFamily:"'DM Mono', monospace", boxSizing:"border-box", marginBottom:12 }}
            />
            <div style={{ display:"flex", gap:10 }}>
              <button onClick={() => setShowApiModal(false)} style={{ flex:1, padding:"11px 0", borderRadius:10, border:"1px solid rgba(120,80,255,0.2)", background:"transparent", color:"rgba(200,185,255,0.6)", fontSize:14, cursor:"pointer", fontFamily:"inherit" }}>Cancel</button>
              <button onClick={() => { if(apiKeyInput.startsWith("sk-")) { setApiKey(apiKeyInput); setShowApiModal(false); toast("API key connected! ⚡"); } else toast("Invalid API key format", "error"); }}
                style={{ flex:2, padding:"11px 0", borderRadius:10, border:"none", background:"linear-gradient(135deg,#7c3aed,#4f46e5)", color:"#fff", fontSize:14, fontWeight:700, cursor:"pointer", fontFamily:"inherit" }}>Connect API Key</button>
            </div>
            <p style={{ fontSize:11, color:"rgba(120,80,255,0.4)", margin:"12px 0 0", textAlign:"center" }}>Get your API key at <span style={{ color:"#a78bfa" }}>platform.openai.com</span></p>
          </div>
        </div>
      )}

      {/* Fullscreen */}
      {fullscreen && (
        <div style={{ position:"fixed", inset:0, background:"rgba(0,0,0,0.95)", zIndex:2000, display:"flex", alignItems:"center", justifyContent:"center" }}
          onClick={() => setFullscreen(null)}>
          <img src={fullscreen.url} alt="" style={{ maxWidth:"90vw", maxHeight:"90vh", borderRadius:16, objectFit:"contain" }} />
        </div>
      )}

      <Toaster toasts={toasts} />
    </div>
  );
}
