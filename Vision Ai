  const toast = useCallback((msg, type="success") => {
    const id = Date.now();
    setToasts(t => [...t, { id, msg, type }]);
    setTimeout(() => setToasts(t => t.filter(x => x.id !== id)), 3000);
  }, []);

  const randomPrompt = () => {
    const p = SAMPLE_PROMPTS[Math.floor(Math.random() * SAMPLE_PROMPTS.length)];
    setPrompt(p);
    toast("Random prompt loaded ✨");
  };

  const enhancePrompt = async () => {
    if (!prompt.trim()) return toast("Enter a prompt first", "error");
    if (!apiKey) { setShowApiModal(true); return; }
    setEnhancing(true);
    try {
      const res = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "claude-sonnet-4-20250514",
          max_tokens: 1000,
          messages: [{ role: "user", content: `Enhance this image generation prompt to be more vivid, detailed, and cinematic. Return ONLY the enhanced prompt, nothing else. Original: "${prompt}"` }],
        }),
      });
      const data = await res.json();
      const enhanced = data.content?.[0]?.text?.trim();
      if (enhanced) { setPrompt(enhanced); toast("Prompt enhanced ✨"); }
    } catch { toast("Enhancement failed", "error"); }
    setEnhancing(false);
  };

  const generate = async () => {
    if (!prompt.trim()) return toast("Please enter a prompt", "error");
    if (!apiKey) { setShowApiModal(true); return; }
    setLoading(true);
    const selectedStyle = STYLE_PRESETS.find(s => s.id === style);
    const fullPrompt = `${prompt}${negPrompt ? `, avoiding: ${negPrompt}` : ""}, ${selectedStyle.suffix}`;
    const [w, h] = ratio.split("x").map(Number);
    try {
      const results = [];
      for (let i = 0; i < Math.min(numImages, 4); i++) {
        const res = await fetch("https://api.openai.com/v1/images/generations", {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${apiKey}` },
          body: JSON.stringify({ model: "dall-e-3", prompt: fullPrompt, n: 1, size: `${w}x${h}`, quality, response_format: "url" }),
        });
        if (!res.ok) { const e = await res.json(); throw new Error(e.error?.message || "API error"); }
        const data = await res.json();
        results.push({ id: Date.now() + i, url: data.data[0].url, prompt, style: selectedStyle.label, ratio, timestamp: new Date().toLocaleTimeString() });
      }
      setImages(prev => [...results, ...prev]);
      setHistory(prev => [...results, ...prev]);
      toast(`${results.length} image${results.length>1?"s":""} generated! 🎨`);
    } catch (e) { toast(e.message || "Generation failed", "error"); }
    setLoading(false);
  };

