  const [negPrompt, setNegPrompt] = useState("");
  const [style, setStyle] = useState("realistic");
  const [ratio, setRatio] = useState("1024x1024");
  const [quality, setQuality] = useState("standard");
  const [numImages, setNumImages] = useState(1);
